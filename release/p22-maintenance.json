      "risk": "low",
      "status": "verified",
      "regressionScope": [
        "Library search",
        "kana-equivalent search",
        "English gloss search",
        "canonical content search",
        "typecheck and unit tests",
        "production build and browser acceptance"
      ],
      "requiresPhysicalDeviceRetest": false,
      "capabilityExpansion": false
    },
    {
      "id": "p22-2026-10-06-library-reload-crash",
      "changeType": "reliability",
      "summary": "Replace crash-prone browser SQLite/WASM Library search with deterministic in-memory search over the bundled canonical corpus; preserve account-scoped IndexedDB for learner state.",
